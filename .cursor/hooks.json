{
  "hooks": {
    "afterFileEdit": [
      {
        "command": "chainloop trace hook cursor after-file-edit",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "chainloop trace hook cursor post-tool-use",
        "matcher": "Shell",
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": "chainloop trace hook cursor pre-tool-use",
        "matcher": "Shell",
        "timeout": 30
      }
    ],
    "sessionEnd": [
      {
        "command": "chainloop trace hook cursor session-end",
        "timeout": 30
      }
    ],
    "sessionStart": [
      {
        "command": "chainloop trace hook cursor session-start",
        "timeout": 30
      }
    ]
  },
  "version": 1
}
