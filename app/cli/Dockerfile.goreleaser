FROM golang:1.27.1@sha256:1e93e00a31255c07e9a34c4207f3006e1501730c5323697cee7dfb827fdae44c AS builder
RUN mkdir -p /.config/chainloop /rootfs/tmp && chmod 1777 /rootfs/tmp

FROM scratch

COPY ./chainloop /
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder --chown=1001:1001 /.config/chainloop /.config/chainloop
# tmp is required for the temporary files the CLI writes, for example the PR/MR metadata
COPY --from=builder /rootfs/ /

USER 1001

ENTRYPOINT [ "./chainloop"]
